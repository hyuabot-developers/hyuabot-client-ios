    "intent.bus.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tells you when buses arrive at stops around campus, by route. e.g. When is the next 10-1 bus?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンパス周辺の停留所に路線別のバスがいつ来るかをお知らせします。例: バスはいつ来る？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "학교 주변 정류장에 노선별 버스가 언제 오는지 알려줘요. 예: 버스 언제 와?, 10-1번 버스 언제 와?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按线路告诉你校园周边站点的公交何时到站。例如：10-1路公交什么时候来？"
          }
        }
      }
    },
    "intent.bus.dialog.next" : {
