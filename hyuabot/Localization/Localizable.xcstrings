    "intent.cafeteria.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tells you today's or tomorrow's cafeteria menu (breakfast, lunch, dinner) by restaurant. e.g. What's for lunch today?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日または明日の学食メニュー(朝食・昼食・夕食)を食堂ごとにお知らせします。例: 今日の学食は何？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘이나 내일의 학식 메뉴(조식·중식·석식)를 식당별로 알려줘요. 예: 오늘 학식 뭐야?, 내일 조식 뭐야?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按餐厅告诉你今天或明天的食堂菜单（早餐、午餐、晚餐）。例如：今天食堂吃什么？"
          }
        }
      }
    },
    "intent.cafeteria.dialog.menu" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
