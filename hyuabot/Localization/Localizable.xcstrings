    "inquiry.welcome" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How can we help? Check common questions instantly with quick answers. For anything else, leave a message and an operator will reply."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのようなご用件でしょうか？よくある質問はクイック回答ですぐに確認できます。その他のお問い合わせはメッセージを残していただければ、運営者がお答えします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇을 도와드릴까요? 자주 묻는 질문은 빠른 응답으로 바로 확인할 수 있어요. 그 밖의 문의는 메시지로 남겨 주시면 운영자가 답변드려요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有什么可以帮您？常见问题可通过快速回答立即查看。其他问题请留言，运营人员会为您解答。"
          }
        }
      }
    },
    "intent.bus.departure.time" : {
