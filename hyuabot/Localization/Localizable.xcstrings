    "intent.subway.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tells you when the next Line 4 or Suin-Bundang Line train arrives at Hanyang Univ. at Ansan Station, by direction. e.g. When is the next train?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハンデアプ駅の4号線・水仁盆唐線の電車がいつ来るかを方面別にお知らせします。例: 電車はいつ来る？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한대앞역 4호선·수인분당선 열차가 언제 오는지 상행·하행별로 알려줘요. 예: 전철 언제 와?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按方向告诉你汉大前站4号线、水仁盆唐线列车何时到站。例如：地铁什么时候来？"
          }
        }
      }
    },
