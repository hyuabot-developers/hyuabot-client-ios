    "intent.shuttle.dialog.next" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The next shuttle from %1$@ (%2$@) leaves in %3$@ min at %4$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@から%2$@のシャトルは%3$@分後(%4$@)に出発します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 %2$@ 셔틀은 %3$@분 후(%4$@)에 출발해요."
          }
        },
        "zh-Hans" : {
