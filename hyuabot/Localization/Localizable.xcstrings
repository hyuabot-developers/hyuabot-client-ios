    "intent.shuttle.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tells you when the next shuttle leaves from the nearest stop. You can choose a stop and a direction. e.g. When is the next shuttle?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最寄りの停留所から次のシャトルバスがいつ出発するかをお知らせします。停留所と方面を選べます。例: シャトルはいつ来る？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 가까운 정류장에서 다음 셔틀버스가 언제 출발하는지 알려줘요. 정류장과 방향을 고를 수 있어요. 예: 셔틀 언제 와?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉你最近站点的下一班校车何时发车，可选择站点和方向。例如：校车什么时候来？"
          }
        }
      }
    },
